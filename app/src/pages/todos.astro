---
import AppLayout from '~/layouts/AppLayout.astro';
import StatusCheckbox from '~/components/StatusCheckbox.svelte';
import RichTextEditor from '~/components/RichTextEditor.svelte';
import { CheckSquare, Plus, Search, Flag, X, Trash2, Archive, Copy, Calendar, User } from 'lucide-svelte';
import { supabase } from '~/lib/supabase';
import { isProjectTeam } from '~/lib/team';
const team = Astro.locals.currentTeam;
const teams = Astro.locals.allowedTeams;
if (!team) return Astro.redirect('/');

// Project teams get the richer view: to-dos grouped by milestone, date filters.
const isProject = isProjectTeam(team);

const url = Astro.url;
const statusFilter = url.searchParams.get('status') ?? 'active'; // active | open | done | archived | all
const assigneeFilter = url.searchParams.get('assignee') ?? 'all';
const sort = url.searchParams.get('sort') ?? (isProject ? 'due' : 'created');
const search = (url.searchParams.get('q') ?? '').trim();
const detailId = url.searchParams.get('detail');
// Project-only filters
const milestoneFilter = isProject ? (url.searchParams.get('milestone') ?? 'all') : 'all'; // all | none | <id>
const dueFilter = isProject ? (url.searchParams.get('due') ?? 'all') : 'all'; // all | overdue | today | week | next7 | nodate | range
const dueFrom = url.searchParams.get('from') ?? '';
const dueTo = url.searchParams.get('to') ?? '';
const group = isProject ? (url.searchParams.get('group') ?? 'milestone') : 'none'; // milestone | owner | none

const ymd = (d: Date) => d.toISOString().slice(0, 10);
const addDays = (d: Date, n: number) => { const x = new Date(d); x.setDate(x.getDate() + n); return x; };
const now = new Date();
const todayYmd = ymd(now);
const weekStart = addDays(now, -now.getDay());       // Sunday
const weekEnd = addDays(weekStart, 6);               // Saturday

const baseQuery = () =>
  supabase
    .from('todos')
    .select(
      'id, title, description, status, is_urgent, due_date, created_at, team_id, assignee_employee_id, milestone_id, ' +
      'assignee:employees!todos_assignee_employee_id_fkey(id, full_name, email), ' +
      'milestone:milestones(id, title, due_date, status)',
    )
    .eq('team_id', team.id);

let q = baseQuery();
if (statusFilter === 'active') q = q.in('status', ['open', 'done']);
else if (statusFilter !== 'all') q = q.eq('status', statusFilter);
if (assigneeFilter !== 'all') q = q.eq('assignee_employee_id', assigneeFilter);
if (milestoneFilter === 'none') q = q.is('milestone_id', null);
else if (milestoneFilter !== 'all') q = q.eq('milestone_id', milestoneFilter);
if (dueFilter === 'overdue') q = q.lt('due_date', todayYmd).neq('status', 'done');
else if (dueFilter === 'today') q = q.eq('due_date', todayYmd);
else if (dueFilter === 'week') q = q.gte('due_date', ymd(weekStart)).lte('due_date', ymd(weekEnd));
else if (dueFilter === 'next7') q = q.gte('due_date', todayYmd).lte('due_date', ymd(addDays(now, 7)));
else if (dueFilter === 'nodate') q = q.is('due_date', null);
else if (dueFilter === 'range') {
  if (dueFrom) q = q.gte('due_date', dueFrom);
  if (dueTo) q = q.lte('due_date', dueTo);
}
if (search) q = q.ilike('title', `%${search}%`);
if (sort === 'due') q = q.order('due_date', { ascending: true, nullsFirst: false }).order('created_at', { ascending: true });
else if (sort === 'title') q = q.order('title', { ascending: true });
else q = q.order('created_at', { ascending: false });

const [{ data: todos }, { data: employees }, { data: milestones }] = await Promise.all([
  q,
  supabase.from('team_memberships').select('employee:employees(id, full_name)').eq('team_id', team.id).order('employee(full_name)').then(({ data }) => ({
    data: (data ?? []).map((m: any) => m.employee).filter(Boolean),
  })),
  isProject
    ? supabase.from('milestones').select('id, title, due_date, status').eq('team_id', team.id).eq('is_archived', false)
        .order('due_date', { ascending: true, nullsFirst: false }).order('priority_order')
    : Promise.resolve({ data: [] as any[] }),
]);

// Group rows for display. Standard teams: one flat group with no header.
type Group = { key: string; title: string | null; meta: any; todos: any[] };
const todoList: any[] = (todos ?? []) as any[];
let groups: Group[];
if (group === 'milestone') {
  const byId = new Map<string, Group>();
  for (const m of milestones ?? []) byId.set(m.id, { key: m.id, title: m.title, meta: m, todos: [] });
  const none: Group = { key: 'none', title: 'No milestone', meta: null, todos: [] };
  for (const t of todoList) {
    const g = t.milestone_id ? byId.get(t.milestone_id) : null;
    (g ?? none).todos.push(t);
  }
  groups = [...byId.values(), none].filter((g) => g.todos.length > 0);
} else if (group === 'owner') {
  const byOwner = new Map<string, Group>();
  for (const t of todoList) {
    const key = t.assignee?.id ?? 'none';
    if (!byOwner.has(key)) byOwner.set(key, { key, title: t.assignee?.full_name ?? 'Unassigned', meta: null, todos: [] });
    byOwner.get(key)!.todos.push(t);
  }
  groups = [...byOwner.values()].sort((a, b) => (a.key === 'none' ? 1 : b.key === 'none' ? -1 : a.title!.localeCompare(b.title!)));
} else {
  groups = [{ key: 'all', title: null, meta: null, todos: todoList }];
}
const openCount = todoList.filter((t) => t.status === 'open').length;
const overdueCount = todoList.filter((t) => t.status === 'open' && t.due_date && t.due_date < todayYmd).length;

let detail: any = null;
if (detailId) {
  const { data } = await baseQuery().eq('id', detailId).maybeSingle();
  detail = data;
}

const fmt = (d: string | null) =>
  d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : '';
const isOverdue = (d: string | null) => !!d && d <= todayYmd;
const milestoneStatusStyles: Record<string, string> = {
  on_track: 'bg-sky-50 text-sky-700 border-sky-200',
  off_track: 'bg-rose-50 text-rose-700 border-rose-200',
  done: 'bg-emerald-50 text-emerald-700 border-emerald-200',
};
const milestoneStatusLabel: Record<string, string> = { on_track: 'On Track', off_track: 'Off Track', done: 'Done' };
// Filter-form link helper: current params with one key changed.
const withParam = (k: string, v: string | null) => {
  const p = new URLSearchParams(url.searchParams);
  p.delete('detail');
  if (v === null || v === '') p.delete(k); else p.set(k, v);
  const qs = p.toString();
  return url.pathname + (qs ? `?${qs}` : '');
};
const initials = (name: string) =>
  name.split(' ').map((n) => n[0]).join('').slice(0, 2).toUpperCase();
const back = Astro.url.pathname + Astro.url.search;
const backNoDetail = Astro.url.pathname + (Astro.url.search ? Astro.url.search.replace(/[?&]detail=[^&]*/, '').replace(/^&/, '?') : '');
---
<AppLayout title="To-Dos · GYE EOS">
  <header class="flex items-start justify-between mb-8">
    <div class="flex items-center gap-3">
      <div class="w-12 h-12 rounded-xl bg-violet-100 grid place-items-center">
        <CheckSquare class="text-violet-600" size={24} />
      </div>
      <div>
        <h1 class="text-2xl font-semibold text-stone-900">To-Dos</h1>
        <p class="text-stone-500 text-sm">
          {isProject
            ? <>{team.name} · project tasks by milestone — <span class="text-stone-700 font-medium">{openCount} open</span>{overdueCount > 0 && <>, <span class="text-rose-600 font-medium">{overdueCount} overdue</span></>}</>
            : <>{team.name} team to-dos</>}
        </p>
      </div>
    </div>
    <form
      method="POST"
      action="/api/todos"
      onsubmit="return confirm('Archive all completed to-dos for this team?');"
    >
      <input type="hidden" name="_action" value="archive_done" />
      <input type="hidden" name="team_id" value={team.id} />
      <input type="hidden" name="back" value={back} />
      <button
        type="submit"
        class="border border-stone-300 bg-white rounded-xl px-4 py-2.5 text-sm font-medium flex items-center gap-1.5 text-stone-700 hover:bg-stone-50"
      >
        <Archive size={16} />
        Archive completed tasks
      </button>
    </form>
  </header>

  <form method="POST" action="/api/todos" class="flex gap-2 mb-4">
    <input type="hidden" name="_action" value="create" />
    <input type="hidden" name="team_id" value={team.id} />
    <input type="hidden" name="back" value={back} />
    <input
      type="text"
      name="title"
      placeholder="Add a new to-do..."
      required
      class="flex-1 bg-white border border-stone-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-violet-400"
    />
    {isProject && (
      <select name="milestone_id" class="bg-white border border-stone-200 rounded-xl px-3 py-3 text-sm max-w-[220px]">
        <option value="" selected={milestoneFilter === 'all' || milestoneFilter === 'none'}>No milestone</option>
        {milestones?.map((m: any) => <option value={m.id} selected={m.id === milestoneFilter}>{m.title}</option>)}
      </select>
    )}
    <select name="assignee_employee_id" class="bg-white border border-stone-200 rounded-xl px-3 py-3 text-sm">
      <option value="">Unassigned</option>
      {employees?.map((e) => <option value={e.id} selected={isProject && e.id === assigneeFilter}>{e.full_name}</option>)}
    </select>
    {isProject && (
      <input type="date" name="due_date" title="Due date" class="bg-white border border-stone-200 rounded-xl px-3 py-3 text-sm" />
    )}
    <button class="bg-stone-800 hover:bg-stone-900 text-white rounded-xl px-5 py-3 text-sm font-medium flex items-center gap-1.5">
      <Plus size={16} />
      Add
    </button>
  </form>

  {isProject && (
    <div class="flex flex-wrap items-center gap-2 mb-3 text-sm">
      <span class="text-xs text-stone-400 mr-1">Due</span>
      {([
        ['all', 'All'], ['overdue', 'Overdue'], ['today', 'Today'], ['week', 'This week'], ['next7', 'Next 7 days'], ['nodate', 'No date'], ['range', 'Range…'],
      ] as const).map(([v, label]) => (
        <a href={withParam('due', v === 'all' ? null : v)}
          class={`px-3 py-1.5 rounded-full border text-xs font-medium transition ${
            dueFilter === v ? 'bg-violet-600 border-violet-600 text-white' : 'bg-white border-stone-200 text-stone-600 hover:border-stone-300'
          }`}>{label}</a>
      ))}
      {dueFilter === 'range' && (
        <form method="GET" class="flex items-center gap-1.5 ml-1">
          {[...url.searchParams.entries()].filter(([k]) => !['from', 'to', 'detail'].includes(k)).map(([k, v]) => <input type="hidden" name={k} value={v} />)}
          <input type="date" name="from" value={dueFrom} class="bg-white border border-stone-200 rounded-lg px-2 py-1 text-xs" />
          <span class="text-stone-400 text-xs">to</span>
          <input type="date" name="to" value={dueTo} class="bg-white border border-stone-200 rounded-lg px-2 py-1 text-xs" />
          <button class="text-xs bg-stone-800 text-white rounded-lg px-2.5 py-1">Go</button>
        </form>
      )}
    </div>
  )}

  <form method="GET" class="flex flex-wrap gap-2 mb-4">
    {isProject && dueFilter !== 'all' && <input type="hidden" name="due" value={dueFilter} />}
    {isProject && dueFrom && <input type="hidden" name="from" value={dueFrom} />}
    {isProject && dueTo && <input type="hidden" name="to" value={dueTo} />}
    <div class="flex-1 min-w-[200px] relative">
      <Search size={16} class="absolute left-3 top-1/2 -translate-y-1/2 text-stone-400" />
      <input
        type="text"
        name="q"
        value={search}
        placeholder="Search to-dos..."
        class="w-full bg-white border border-stone-200 rounded-xl pl-9 pr-4 py-2.5 text-sm focus:outline-none focus:border-violet-400"
      />
    </div>
    <select name="status" onchange="this.form.submit()" class="bg-white border border-stone-200 rounded-xl px-4 py-2.5 text-sm">
      <option value="active"   selected={statusFilter === 'active'}>Open &amp; Done</option>
      <option value="open"     selected={statusFilter === 'open'}>Open only</option>
      <option value="done"     selected={statusFilter === 'done'}>Done only</option>
      <option value="archived" selected={statusFilter === 'archived'}>Archived</option>
      <option value="all"      selected={statusFilter === 'all'}>All</option>
    </select>
    <select name="assignee" onchange="this.form.submit()" class="bg-white border border-stone-200 rounded-xl px-4 py-2.5 text-sm">
      <option value="all" selected={assigneeFilter === 'all'}>All Assignees</option>
      {employees?.map((e) => <option value={e.id} selected={assigneeFilter === e.id}>{e.full_name}</option>)}
    </select>
    {isProject && (
      <select name="milestone" onchange="this.form.submit()" class="bg-white border border-stone-200 rounded-xl px-4 py-2.5 text-sm max-w-[220px]">
        <option value="all"  selected={milestoneFilter === 'all'}>All Milestones</option>
        <option value="none" selected={milestoneFilter === 'none'}>No milestone</option>
        {milestones?.map((m: any) => <option value={m.id} selected={milestoneFilter === m.id}>{m.title}</option>)}
      </select>
    )}
    <select name="sort" onchange="this.form.submit()" class="bg-white border border-stone-200 rounded-xl px-4 py-2.5 text-sm">
      <option value="created" selected={sort === 'created'}>Created Date</option>
      <option value="due"     selected={sort === 'due'}>Due Date</option>
      <option value="title"   selected={sort === 'title'}>Title</option>
    </select>
    {isProject && (
      <select name="group" onchange="this.form.submit()" class="bg-white border border-stone-200 rounded-xl px-4 py-2.5 text-sm">
        <option value="milestone" selected={group === 'milestone'}>Group: Milestone</option>
        <option value="owner"     selected={group === 'owner'}>Group: Owner</option>
        <option value="none"      selected={group === 'none'}>No grouping</option>
      </select>
    )}
  </form>

  <div class="space-y-4">
    {todos && todos.length > 0 ? groups.map((g) => (
      <section>
        {g.title !== null && (
          <div class="flex items-center gap-3 px-1 mb-2">
            {group === 'milestone' ? <Flag size={15} class="text-amber-500 shrink-0" /> : <User size={15} class="text-stone-400 shrink-0" />}
            {g.meta ? (
              <a href={`/rocks?milestone=${g.meta.id}`} class="font-semibold text-stone-900 hover:text-violet-700">{g.title}</a>
            ) : (
              <span class="font-semibold text-stone-700">{g.title}</span>
            )}
            {g.meta && (
              <span class={`text-[11px] px-2 py-0.5 rounded-full border ${milestoneStatusStyles[g.meta.status] ?? ''}`}>{milestoneStatusLabel[g.meta.status] ?? g.meta.status}</span>
            )}
            {g.meta?.due_date && (
              <span class={`text-xs flex items-center gap-1 ${isOverdue(g.meta.due_date) && g.meta.status !== 'done' ? 'text-rose-500' : 'text-stone-500'}`}><Calendar size={12} /> {fmt(g.meta.due_date)}</span>
            )}
            <span class="text-xs text-stone-400">{g.todos.filter((t: any) => t.status === 'open').length} open · {g.todos.length} total</span>
          </div>
        )}
        <div class="bg-white border border-stone-200 rounded-xl divide-y divide-stone-100">
      {g.todos.map((t: any) => {
        const done = t.status === 'done';
        const detailHref = `?${new URLSearchParams({ ...Object.fromEntries(url.searchParams), detail: t.id }).toString()}`;
        return (
          <div class="flex items-center gap-3 px-4 py-3 group">
            <StatusCheckbox client:load id={t.id} status={t.status} endpoint="/api/todos" />
            <a
              href={detailHref}
              class={`flex-1 text-sm hover:text-violet-600 ${done ? 'text-stone-400 line-through' : 'text-stone-800'}`}
            >
              {t.title}
            </a>
            {t.is_urgent && <Flag size={14} class="text-rose-500" />}
            {isProject && group !== 'milestone' && t.milestone && (
              <span class="hidden md:inline text-[11px] text-amber-700 bg-amber-50 border border-amber-200 rounded-full px-2 py-0.5 truncate max-w-[180px]" title={t.milestone.title}>{t.milestone.title}</span>
            )}
            {t.due_date && <span class={`text-xs font-medium ${isOverdue(t.due_date) && !done ? 'text-rose-500' : 'text-stone-500'}`}>{fmt(t.due_date)}</span>}
            {t.assignee && (
              <div class="flex items-center gap-1.5 text-xs text-stone-500">
                <div class="w-6 h-6 rounded-full bg-violet-100 text-violet-700 grid place-items-center text-[10px] font-semibold">
                  {initials(t.assignee.full_name)}
                </div>
                <span class="text-stone-600 font-medium">{t.assignee.full_name.split(' ')[0]}</span>
              </div>
            )}
            {!isProject && <div class="text-xs text-stone-400 w-12 text-right">{fmt(t.created_at)}</div>}
            <form method="POST" action="/api/todos" class="opacity-0 group-hover:opacity-100 transition">
              <input type="hidden" name="_action" value="update" />
              <input type="hidden" name="id" value={t.id} />
              <input type="hidden" name="title" value={t.title} />
              <input type="hidden" name="status" value={t.status === 'archived' ? 'open' : 'archived'} />
              <input type="hidden" name="back" value={back} />
              <button
                class="p-1.5 rounded text-stone-400 hover:text-stone-800 hover:bg-stone-100"
                title={t.status === 'archived' ? 'Unarchive' : 'Archive'}
              >
                <Archive size={14} />
              </button>
            </form>
          </div>
        );
      })}
        </div>
      </section>
    )) : (
      <div class="bg-white border border-stone-200 rounded-xl px-4 py-12 text-center text-sm text-stone-400">No to-dos matching the filters.</div>
    )}
  </div>

  {detail && (
    <div class="fixed inset-0 z-30">
      <a href={backNoDetail} class="absolute inset-0 bg-black/20"></a>
      <aside class="absolute right-0 top-0 bottom-0 w-full max-w-md bg-white shadow-2xl overflow-y-auto">
        <div class="p-6 space-y-5">
          <div class="flex items-center justify-between">
            <span class="inline-block text-xs font-medium text-stone-600 bg-stone-100 rounded-full px-2.5 py-1">
              {team.name}
            </span>
            <a href={backNoDetail} class="p-1 text-stone-400 hover:text-stone-700"><X size={18} /></a>
          </div>
          <h2 class="text-xl font-semibold text-stone-900">To-Do Details</h2>

          <div class="flex gap-2">
            <form method="POST" action="/api/todos">
              <input type="hidden" name="_action" value="update" />
              <input type="hidden" name="id" value={detail.id} />
              <input type="hidden" name="status" value={detail.status === 'done' ? 'open' : 'done'} />
              <input type="hidden" name="title" value={detail.title} />
              <input type="hidden" name="back" value={backNoDetail} />
              <button class="flex items-center gap-1.5 border border-emerald-300 text-emerald-700 bg-emerald-50 hover:bg-emerald-100 hover:border-emerald-400 transition rounded-lg px-3 py-1.5 text-sm font-medium">
                ✓ {detail.status === 'done' ? 'Mark Open' : 'Mark Done'}
              </button>
            </form>
            <form method="POST" action="/api/todos">
              <input type="hidden" name="_action" value="update" />
              <input type="hidden" name="id" value={detail.id} />
              <input type="hidden" name="status" value="archived" />
              <input type="hidden" name="title" value={detail.title} />
              <input type="hidden" name="back" value={backNoDetail} />
              <button class="flex items-center gap-1.5 border border-stone-300 text-stone-700 bg-white hover:bg-stone-100 hover:border-stone-400 transition rounded-lg px-3 py-1.5 text-sm font-medium">
                <Archive size={14} /> Archive
              </button>
            </form>
            <form method="POST" action="/api/todos" onsubmit="return confirm('Delete this to-do? This cannot be undone.');">
              <input type="hidden" name="_action" value="delete" />
              <input type="hidden" name="id" value={detail.id} />
              <input type="hidden" name="back" value={backNoDetail} />
              <button class="flex items-center gap-1.5 border border-rose-300 text-rose-700 bg-white hover:bg-rose-50 hover:border-rose-400 transition rounded-lg px-3 py-1.5 text-sm font-medium">
                <Trash2 size={14} /> Delete
              </button>
            </form>
          </div>

          <div class="flex gap-2">
            <button type="button" data-clone-open="todo"
              class="flex items-center gap-1.5 border border-sky-300 text-sky-700 bg-sky-50 hover:bg-sky-100 hover:border-sky-400 transition rounded-lg px-3 py-1.5 text-sm font-medium">
              <Copy size={14} /> Clone as To-Do
            </button>
            <button type="button" data-clone-open="issue"
              class="flex items-center gap-1.5 border border-violet-300 text-violet-700 bg-violet-50 hover:bg-violet-100 hover:border-violet-400 transition rounded-lg px-3 py-1.5 text-sm font-medium">
              <Copy size={14} /> Clone as Issue
            </button>
          </div>

          <form method="POST" action="/api/todos" class="space-y-4"
            data-autosave-form data-autosave-url="/api/todos" data-autosave-id={detail.id}>
            <input type="hidden" name="_action" value="update" />
            <input type="hidden" name="id" value={detail.id} />
            <input type="hidden" name="back" value={backNoDetail} />

            <div>
              <label class="text-sm font-medium text-stone-700">Title</label>
              <input type="text" name="title" value={detail.title}
                data-autosave="title"
                class="mt-1 w-full bg-white border border-stone-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-violet-400" />
            </div>

            <div>
              <label class="text-sm font-medium text-stone-700">Description</label>
              <div class="mt-1">
                <RichTextEditor
                  client:only="svelte"
                  name="description"
                  initial={detail.description ?? ''}
                  autosaveUrl="/api/todos"
                  autosaveId={detail.id}
                />
              </div>
            </div>

            <div>
              <label class="text-sm font-medium text-stone-700">Team</label>
              <select name="team_id" data-autosave="team_id" class="mt-1 w-full bg-white border border-stone-300 rounded-lg px-3 py-2 text-sm">
                {teams.map((t) => <option value={t.id} selected={t.id === detail.team_id}>{t.name}</option>)}
              </select>
            </div>

            {isProject && (
              <div>
                <label class="text-sm font-medium text-stone-700">Milestone</label>
                <select name="milestone_id" data-autosave="milestone_id" class="mt-1 w-full bg-white border border-stone-300 rounded-lg px-3 py-2 text-sm">
                  <option value="">No milestone</option>
                  {milestones?.map((m: any) => <option value={m.id} selected={m.id === detail.milestone_id}>{m.title}</option>)}
                </select>
              </div>
            )}

            <div>
              <label class="text-sm font-medium text-stone-700">Assignee</label>
              <select name="assignee_employee_id" data-autosave="assignee_employee_id" class="mt-1 w-full bg-white border border-stone-300 rounded-lg px-3 py-2 text-sm">
                <option value="">Unassigned</option>
                {employees?.map((e) => <option value={e.id} selected={e.id === detail.assignee_employee_id}>{e.full_name}</option>)}
              </select>
            </div>

            <div>
              <label class="text-sm font-medium text-stone-700">Due Date</label>
              <input type="date" name="due_date" value={detail.due_date ?? ''}
                data-autosave="due_date"
                class="mt-1 w-full bg-white border border-stone-300 rounded-lg px-3 py-2 text-sm" />
            </div>

            <label class="flex items-center gap-2 text-sm text-stone-700">
              <input type="checkbox" name="is_urgent" checked={detail.is_urgent} data-autosave="is_urgent" />
              Urgent
            </label>

            <div id="field-autosave-status" class="text-xs h-4 text-right tabular-nums"></div>
            <button class="w-full bg-violet-600 hover:bg-violet-700 text-white rounded-lg py-2.5 text-sm font-medium">
              Save changes
            </button>
          </form>
        </div>

        <div id="clone-todo-modal" class="hidden fixed inset-0 z-40 grid place-items-center p-4">
          <div class="absolute inset-0 bg-black/40" data-clone-close="todo"></div>
          <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-lg max-h-[90vh] overflow-y-auto">
            <form method="POST" action="/api/todos" class="p-6 space-y-4">
              <div class="flex items-center justify-between">
                <h3 class="text-lg font-semibold text-stone-900">Clone as To-Do</h3>
                <button type="button" data-clone-close="todo" class="p-1 text-stone-400 hover:text-stone-700"><X size={18} /></button>
              </div>
              <input type="hidden" name="_action" value="create" />
              <input type="hidden" name="back" value={backNoDetail} />
              {isProject && detail.milestone_id && <input type="hidden" name="milestone_id" value={detail.milestone_id} />}
              <div>
                <label class="text-sm font-medium text-stone-700">Title</label>
                <input type="text" name="title" value={`${detail.title} (copy)`} required
                  class="mt-1 w-full bg-white border border-stone-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-violet-400" />
              </div>
              <div>
                <label class="text-sm font-medium text-stone-700">Description</label>
                <textarea name="description" rows="4"
                  class="mt-1 w-full bg-white border border-stone-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-violet-400"
                  set:html={detail.description ?? ''} />
              </div>
              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label class="text-sm font-medium text-stone-700">Team</label>
                  <select name="team_id" class="mt-1 w-full bg-white border border-stone-300 rounded-lg px-3 py-2 text-sm">
                    {teams.map((t) => <option value={t.id} selected={t.id === detail.team_id}>{t.name}</option>)}
                  </select>
                </div>
                <div>
                  <label class="text-sm font-medium text-stone-700">Due date</label>
                  <input type="date" name="due_date" value={detail.due_date ?? (() => { const d = new Date(); d.setDate(d.getDate() + 7); return d.toISOString().slice(0, 10); })()}
                    class="mt-1 w-full bg-white border border-stone-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-violet-400" />
                </div>
              </div>
              <div>
                <label class="text-sm font-medium text-stone-700">Assignee</label>
                <select name="assignee_employee_id" class="mt-1 w-full bg-white border border-stone-300 rounded-lg px-3 py-2 text-sm">
                  <option value="">Unassigned</option>
                  {employees?.map((e) => <option value={e.id} selected={e.id === detail.assignee_employee_id}>{e.full_name}</option>)}
                </select>
              </div>
              <label class="flex items-center gap-2 text-sm text-stone-700">
                <input type="checkbox" name="is_urgent" checked={detail.is_urgent} />
                Mark as urgent
              </label>
              <div class="flex gap-2 pt-2">
                <button type="button" data-clone-close="todo"
                  class="flex-1 border border-stone-300 text-stone-700 rounded-lg py-2.5 text-sm font-medium">Cancel</button>
                <button type="submit"
                  class="flex-1 bg-sky-600 hover:bg-sky-700 text-white rounded-lg py-2.5 text-sm font-medium">Create to-do</button>
              </div>
            </form>
          </div>
        </div>

        <div id="clone-issue-modal" class="hidden fixed inset-0 z-40 grid place-items-center p-4">
          <div class="absolute inset-0 bg-black/40" data-clone-close="issue"></div>
          <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-lg max-h-[90vh] overflow-y-auto">
            <form method="POST" action="/api/issues" class="p-6 space-y-4">
              <div class="flex items-center justify-between">
                <h3 class="text-lg font-semibold text-stone-900">Clone as Issue</h3>
                <button type="button" data-clone-close="issue" class="p-1 text-stone-400 hover:text-stone-700"><X size={18} /></button>
              </div>
              <input type="hidden" name="_action" value="create" />
              <input type="hidden" name="back" value={backNoDetail} />
              <div>
                <label class="text-sm font-medium text-stone-700">Title</label>
                <input type="text" name="title" value={detail.title} required
                  class="mt-1 w-full bg-white border border-stone-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-violet-400" />
              </div>
              <div>
                <label class="text-sm font-medium text-stone-700">Description</label>
                <textarea name="description" rows="4"
                  class="mt-1 w-full bg-white border border-stone-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-violet-400"
                  set:html={detail.description ?? ''} />
              </div>
              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label class="text-sm font-medium text-stone-700">Priority</label>
                  <select name="priority" class="mt-1 w-full bg-white border border-stone-300 rounded-lg px-3 py-2 text-sm">
                    {[1, 2, 3, 4, 5].map((p) => <option value={p} selected={p === (detail.is_urgent ? 1 : 3)}>P{p}</option>)}
                  </select>
                </div>
                <div>
                  <label class="text-sm font-medium text-stone-700">Term</label>
                  <select name="term_type" class="mt-1 w-full bg-white border border-stone-300 rounded-lg px-3 py-2 text-sm">
                    <option value="short_term" selected>Short term</option>
                    <option value="long_term">Long term</option>
                  </select>
                </div>
              </div>
              <div>
                <label class="text-sm font-medium text-stone-700">Team</label>
                <select name="team_id" class="mt-1 w-full bg-white border border-stone-300 rounded-lg px-3 py-2 text-sm">
                  {teams.map((t) => <option value={t.id} selected={t.id === detail.team_id}>{t.name}</option>)}
                </select>
              </div>
              <div>
                <label class="text-sm font-medium text-stone-700">Owner</label>
                <select name="owner_employee_id" class="mt-1 w-full bg-white border border-stone-300 rounded-lg px-3 py-2 text-sm">
                  <option value="">Unassigned</option>
                  {employees?.map((e) => <option value={e.id} selected={e.id === detail.assignee_employee_id}>{e.full_name}</option>)}
                </select>
              </div>
              <div class="flex gap-2 pt-2">
                <button type="button" data-clone-close="issue"
                  class="flex-1 border border-stone-300 text-stone-700 rounded-lg py-2.5 text-sm font-medium">Cancel</button>
                <button type="submit"
                  class="flex-1 bg-violet-600 hover:bg-violet-700 text-white rounded-lg py-2.5 text-sm font-medium">Create issue</button>
              </div>
            </form>
          </div>
        </div>
      </aside>
    </div>
  )}

  <script>
    (function () {
      const form = document.querySelector('[data-autosave-form]') as HTMLFormElement | null;
      if (!form) return;
      const url = (form as HTMLElement).dataset.autosaveUrl!;
      const id = (form as HTMLElement).dataset.autosaveId!;
      const statusEl = document.getElementById('field-autosave-status');
      let resetTimer: ReturnType<typeof setTimeout>;

      function setStatus(text: string, cls: string) {
        if (!statusEl) return;
        statusEl.textContent = text;
        statusEl.className = `text-xs h-4 text-right tabular-nums transition-colors ${cls}`;
        clearTimeout(resetTimer);
        if (text) resetTimer = setTimeout(() => { statusEl.textContent = ''; }, 2000);
      }

      async function doSave(field: string, value: unknown) {
        setStatus('Saving…', 'text-stone-400');
        try {
          const res = await fetch(url, {
            method: 'PATCH',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ id, [field]: value }),
          });
          if (!res.ok) throw new Error();
          setStatus('Saved', 'text-emerald-600');
        } catch {
          setStatus('Error saving', 'text-rose-600');
        }
      }

      form.querySelectorAll<HTMLElement>('[data-autosave]').forEach(el => {
        const field = el.dataset.autosave!;
        if (el instanceof HTMLSelectElement) {
          el.addEventListener('change', () => doSave(field, el.value || null));
        } else if (el instanceof HTMLInputElement) {
          if (el.type === 'checkbox') {
            el.addEventListener('change', () => doSave(field, el.checked));
          } else if (el.type === 'date') {
            el.addEventListener('change', () => doSave(field, el.value || null));
          } else {
            el.addEventListener('blur', () => doSave(field, el.value));
          }
        }
      });
    })();

    document.querySelectorAll('[data-clone-open]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const kind = (btn as HTMLElement).dataset.cloneOpen;
        document.getElementById(`clone-${kind}-modal`)?.classList.remove('hidden');
      });
    });
    document.querySelectorAll('[data-clone-close]').forEach((el) => {
      el.addEventListener('click', () => {
        const kind = (el as HTMLElement).dataset.cloneClose;
        document.getElementById(`clone-${kind}-modal`)?.classList.add('hidden');
      });
    });
  </script>
</AppLayout>
